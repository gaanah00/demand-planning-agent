# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=
# Model used by the agent (any Claude model that supports tool use)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional limits
DPA_MAX_TOOL_ITERATIONS=12
DPA_MAX_SECONDS=240
DPA_MAX_UPLOAD_MB=300
# Optional: require a password to open the app (leave empty for no password)
APP_PASSWORD=
